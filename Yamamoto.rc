IDR_MENU_EDIT MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "ソース一覧に追加(&A)",                IDM_EDITADDSRC
        MENUITEM SEPARATOR
        MENUITEM "ファイルを開く(&O)",                 IDM_EDITOPEN
        MENUITEM "名前を付けて保存(&S)",                IDM_EDITSAVE
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&C)",                     IDM_EDITCLOSE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl + Z",          IDM_EDITUNDO
        MENUITEM "やり直し(&R)\tCtrl + Y",          IDM_EDITREDO
        MENUITEM SEPARATOR
        MENUITEM "切り取り(&T)\tCtrl + X",          IDM_EDITCUT
        MENUITEM "ｺﾋﾟｰ(&C)\tCtrl + C",          IDM_EDITCOPY
        MENUITEM "貼り付け(&P)\tCtrl + P",          IDM_EDITPASTE
        MENUITEM "削除(&D)\tDel",                 IDM_EDITDEL
        MENUITEM SEPARATOR
        MENUITEM "全て選択(&A)\tCtrl + A",          IDM_EDITALLSEL
    END
END

IDR_MENU_LVPOPUP MENU
BEGIN
    POPUP "Tree Expand Popup"
    BEGIN
        MENUITEM "展開 (&E)",                     IDM_EXPAND
        MENUITEM "全て展開 (&A)",                   IDM_ALLEXPAND
        MENUITEM SEPARATOR
        MENUITEM "プロパティ(&P)",                   IDM_ITEMPROPERTY
        MENUITEM SEPARATOR
        MENUITEM "コピー (&C)\tCtrl + C",          IDM_COPY
        MENUITEM "貼り付け(&P)\tCtrl + V",          IDM_PASTE
    END
    POPUP "Tree Collapse Popup"
    BEGIN
        MENUITEM "閉じる (&C)",                    IDM_COLLAPSE
        MENUITEM "全て展開 (&A)",                   IDM_ALLEXPAND
        MENUITEM SEPARATOR
        MENUITEM "プロパティ(&P)",                   IDM_ITEMPROPERTY
        MENUITEM SEPARATOR
        MENUITEM "コピー (&C)\tCtrl + C",          IDM_COPY
        MENUITEM "貼り付け(&P)\tCtrl + V",          IDM_PASTE
    END
    POPUP "Normal Tree Item"
    BEGIN
        MENUITEM "プロパティ(&P)",                   IDM_ITEMPROPERTY
        MENUITEM SEPARATOR
        MENUITEM "コピー (&C)\tCtrl + C",          IDM_COPY
        MENUITEM "貼り付け(&P)\tCtrl + V",          IDM_PASTE
    END
    POPUP "Dummy"
    BEGIN
        MENUITEM "AutoExpand",                  IDM_AUTOEXPAND
    END
END

IDR_MENU_MAIN MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規解析(&N)\tCrrl + N",          IDM_NEW
        MENUITEM "新規ウィンドウ(&W)\tCrrl + Shift + N", IDM_NEW_APP
        MENUITEM SEPARATOR
        MENUITEM "ソースファイルを開く(&O)\tCtrl + O",    IDM_OPENSRC
        MENUITEM "データファイルを開く(&D)",              IDM_OPENDAT
        POPUP "解析結果をファイルに出力 (&T)"
        BEGIN
            MENUITEM "CSV形式で出力 (&C)",               IDM_SAVE_CSV
            MENUITEM "COBOLソース出力 (&O)",             IDM_SAVE_CBL
        END
        MENUITEM SEPARATOR
        POPUP "最近解析したソースファイル(&H)"
        BEGIN
            MENUITEM "履歴はありません",                    IDM_HISTORY, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "アプリケーションの終了(&X)\tAlt + F4",   IDM_END
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "コピー (&C)\tCtrl + C",          IDM_COPY
        MENUITEM "貼り付け(&P)\tCtrl + V",          IDM_PASTE
        MENUITEM SEPARATOR
        MENUITEM "解析結果検索(&F)\tCtrl + F",        IDM_FIND
        MENUITEM SEPARATOR
        MENUITEM "ソースコード編集(&E)\tCtrl + E",      IDM_EDITDLG
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "アウトプット (&O)",                 IDM_OUTPUT_VIEW
        MENUITEM SEPARATOR
        MENUITEM "出力 (&T)\tCtrl + 1",           IDM_TRACE_VIEW
        MENUITEM "ソース一覧 (&L)\tCtrl + 2",        IDM_SOURCE_VIEW
        MENUITEM "検索結果 (&S)\tCtrl + 3",         IDM_SEARCH_VIEW
        MENUITEM "データファイル (&D)\tCtrl + 4",      IDM_DATA_VIEW
        MENUITEM SEPARATOR
        MENUITEM "設定(&S)\tF12",                 IDM_SETUP
    END
    POPUP "解析(&A)"
    BEGIN
        MENUITEM "解析開始(&A)\tCtrl+A",            IDM_ANACBL
        MENUITEM SEPARATOR
        MENUITEM "解析設定の表示(&V)",                 IDM_VIEWANACBL
        MENUITEM SEPARATOR
        POPUP "解析対象ソース一覧(&S)"
        BEGIN
            MENUITEM "最新の状態に更新 (&R)\tF5",           IDM_REFLESHSRC
            MENUITEM SEPARATOR
            MENUITEM "全て削除(&A)",                    IDM_CLOSEALLSRC
        END
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "バージョン情報(&A)",                 IDM_VERSIONINFO
    END
END

IDR_MENU_OUTPOPUP MENU
BEGIN
    POPUP "Source List Popup"
    BEGIN
        MENUITEM "開く(&O)\tEnter",               IDM_SHOPENSRC
        MENUITEM SEPARATOR
        MENUITEM "上に移動(&U)\tAlt + Up",          IDM_SRC_UP
        MENUITEM "下に移動(&D)\tAlt + Down",        IDM_SRC_DOWN
        MENUITEM SEPARATOR
        MENUITEM "削除(&R)\tDelete",              IDM_CLOSESRC
        MENUITEM "全て削除(&A)",                    IDM_CLOSEALLSRC
        MENUITEM SEPARATOR
        MENUITEM "最新の状態に更新 (&R)",               IDM_REFLESHSRC
    END
    POPUP "Source List Popup NoSel"
    BEGIN
        MENUITEM "全て削除(&A)",                    IDM_CLOSEALLSRC
        MENUITEM SEPARATOR
        MENUITEM "最新の状態に更新(&R)",                IDM_REFLESHSRC
    END
    POPUP "Search List Popup"
    BEGIN
        MENUITEM "表示(&S)\tEnter",               IDM_SEARCH_SEL
        MENUITEM SEPARATOR
        MENUITEM "検索結果消去(&C)",                  IDM_SEARCH_CLEAR
    END
    POPUP "Data Popup"
    BEGIN
        MENUITEM "次のレコード\tAlt+→",               IDM_NEXTDAT
        MENUITEM "前のレコード\tAlt+←",               IDM_PREVDAT
    END
END

IDR_MENU_SUB MENU
BEGIN
    POPUP "IDM_OPENSRC"
    BEGIN
        MENUITEM "ソースファイルを開く(&O)",              IDM_OPENSRC
        MENUITEM "クリップボードﾞから開く(&P)",            IDM_PASTE
        MENUITEM "ソースコード編集(&E)",                IDM_EDITDLG
    END
    POPUP "IDM_ANACBL"
    BEGIN
        MENUITEM "解析開始(&A)",                    IDM_ANACBL
        MENUITEM SEPARATOR
        MENUITEM "解析設定の表示(&V)",                 IDM_VIEWANACBL
    END
    POPUP "IDM_HISTORY"
    BEGIN
        MENUITEM "Dlete History",               IDM_DELETEHISTORY
    END
END


